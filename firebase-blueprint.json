{
  "entities": {
    "Tab": {
      "title": "Tab",
      "description": "A user category tab for organizing notes",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "color": {
          "type": "string",
          "enum": ["blue", "indigo", "purple", "emerald", "amber", "rose", "cyan", "orange"]
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": ["name", "color", "userId", "createdAt"]
    },
    "Note": {
      "title": "Note",
      "description": "A user note or task inside a tab",
      "type": "object",
      "properties": {
        "tabId": {
          "type": "string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "content": {
          "type": "string",
          "maxLength": 10000
        },
        "isCompleted": {
          "type": "boolean"
        },
        "completedAt": {
          "type": "number"
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "isPinned": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "number"
        },
        "updatedAt": {
          "type": "number"
        }
      },
      "required": ["tabId", "userId", "title", "content", "isCompleted", "priority", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/tabs/{tabId}": {
      "schema": {
        "$ref": "#/entities/Tab"
      },
      "description": "Private collection of tabs belonging to an authenticated user"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": {
        "$ref": "#/entities/Note"
      },
      "description": "Private collection of notes belonging to an authenticated user"
    }
  }
}
