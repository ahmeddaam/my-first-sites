rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny all documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTab(data, userId) {
      return data.keys().hasAll(['name', 'color', 'userId', 'createdAt'])
        && data.keys().hasOnly(['name', 'color', 'userId', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.color in ['blue', 'indigo', 'purple', 'emerald', 'amber', 'rose', 'cyan', 'orange']
        && data.userId == userId && data.userId == request.auth.uid
        && data.createdAt is number;
    }

    function isValidNote(data, userId) {
      return data.keys().hasAll(['tabId', 'userId', 'title', 'content', 'isCompleted', 'priority', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['tabId', 'userId', 'title', 'content', 'isCompleted', 'priority', 'createdAt', 'updatedAt', 'completedAt', 'isPinned'])
        && data.tabId is string && data.tabId.size() > 0 && data.tabId.size() <= 128
        && data.userId == userId && data.userId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.content is string && data.content.size() <= 10000
        && data.isCompleted is bool
        && data.priority in ['low', 'medium', 'high']
        && data.createdAt is number
        && data.updatedAt is number;
    }

    match /users/{userId} {
      match /tabs/{tabId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(tabId) && isValidTab(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(tabId) && isValidTab(incoming(), userId)
                      && incoming().userId == existing().userId
                      && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }

      match /notes/{noteId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(noteId) && isValidNote(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(noteId) && isValidNote(incoming(), userId)
                      && incoming().userId == existing().userId
                      && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }
    }
  }
}
